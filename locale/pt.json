 log"]},"Installation Complete!":{"*":["Instalação Completa!"]},"Jellyfin is ready!":{"*":["Jellyfin está pronto!"]},"Open the Jellyfin app on your TV":{"*":["Abra o aplicativo Jellyfin na sua TV"]},"Done":{"*":["Concluído"]},"Log copied":{"*":["Log copiado"]},"Tizen version unavailable":{"*":["Versão do Tizen indisponível"]},"This TV needs a Samsung certificate":{"*":["Esta TV precisa de um certificado da Samsung"]},"Tizen {version} only accepts packages signed with a certificate issued by Samsung for your account, with this TV registered. Create one in Tizen Studio's Certificate Manager, then add it under Certificates.":{"*":["O Tizen {version} aceita apenas pacotes assinados com um certificado emitido pela Samsung para sua conta, com esta TV registrada. Crie um no Certificate Manager do Tizen Studio e depois adicione-o em Certificados."]},"No device selected - please go back":{"*":["Nenhum dispositivo selecionado - por favor, volte."]},"No TV configured. Please go back and select a device.":{"*":["Nenhuma TV configurada. Por favor, volte e selecione um dispositivo."]},"Starting Installation":{"*":["Iniciando a Instalação"]},"Downloading container...":{"*":["Baixando contêiner..."]},"Pulling Docker image...":{"*":["Baixando imagem Docker..."]},"Container ready!":{"*":["Container pronto!"]},"Installing to TV...":{"*":["Instalando na TV..."]},"Connecting and installing...":{"*":["Conectando e instalando..."]},"This may take a few minutes...":{"*":["Isso pode levar alguns minutos..."]},"Installing...":{"*":["Instalando..."]},"Downloading app...":{"*":["Baixando aplicativo..."]},"Transferring...":{"*":["Transferindo..."]},"Connecting to TV...":{"*":["Conectando à TV..."]},"Finishing...":{"*":["Finalizando..."]},"Extracting layers...":{"*":["Extraindo camadas..."]},"Download complete":{"*":["Download concluído"]},"Error":{"*":["Erro"]},"Jellyfin is now on your TV":{"*":["O Jellyfin agora está na sua TV"]},"Reinstall":{"*":["Reinstalar"]},"Find Jellyfin in your TV's app