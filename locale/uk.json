fin"]},"Apply Server Customizations":{"*":["Застосувати налаштування сервера"]},"Load them again every time the app starts on the TV":{"*":["Завантажувати їх знову щоразу, коли застосунок запускається на телевізорі"]},"Test Connection":{"*":["Перевірити з'єднання"]},"Check that the server answers before building":{"*":["Перевіряти відповідь сервера перед збиранням"]},"Test":{"*":["Перевірити"]},"Enter a server URL first":{"*":["Спочатку введіть URL-адресу сервера"]},"That does not look like an address":{"*":["Це не схоже на адресу"]},"Testing…":{"*":["Перевірка…"]},"Could not reach the server":{"*":["Не вдалося з'єднатися із сервером"]},"Connected to {name}":{"*":["Підключено до {name}"]},"Reset All Settings?":{"*":["Скинути всі налаштування?"]},"This will reset all preferences to their default values. This action cannot be undone.":{"*":["Це скине всі налаштування до їхніх значень за замовчуванням. Цю дію не можна скасувати."]},"Install Jellyfin":{"*":["Встановити Jellyfin"]},"One-click installation to your Samsung TV":{"*":["Одноразова установка на ваш Samsung TV"]},"Target Device":{"*":["Цільовий пристрій"]},"Loading...":{"*":["Завантаження..."]},"Installation Progress":{"*":["Прогрес інсталяції"]},"Ready to install":{"*":["Готово до встановлення"]},"Click the button below to start":{"*":["Натисніть кнопку нижче, щоб почати"]},"Installation progress":{"*":["Прогрес інсталяції"]},"Waiting to start...":{"*":["Очікування початку..."]},"Installation status updates":{"*":["Оновлення статусу встановлення"]},"Install Jellyfin on TV":{"*":["Встановити Jellyfin на телевізорі"]},"Cancel installation":{"*":["Скасувати установку"]},"Installation Log":{"*":["Інсталяційний журнал"]},"Click to view detailed output":{"*":["Натисніть, щоб переглянути детальний вихід"]},"Copy the log":{"*":["Копіювати журнал"]},"Installation Complete!":{"*":["Установка завершена!"]},"Jellyfin is ready!":{"*":["Jellyfin готовий!"]},"Open the Jellyfin app on your TV":{"*":["Відкрийте додаток Jellyfi