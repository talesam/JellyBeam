ements":{"*":["Provjeri zahtjeve"]},"Ensure Docker is installed":{"*":["Osigurajte da je Docker instaliran"]},"Connect Device":{"*":["Poveži uređaj"]},"Find your TV on the network":{"*":["Pronađite svoj TV na mreži"]},"Configure signing (auto by default)":{"*":["Konfiguriraj potpisivanje (automatski prema zadanim postavkama)"]},"One click to deploy Jellyfin":{"*":["Jedan klik za implementaciju Jellyfina"]},"System Requirements":{"*":["Sistemski zahtjevi"]},"Docker Engine":{"*":["Docker Engine"]},"Checking...":{"*":["Provjera..."]},"Install Docker":{"*":["Instalirajte Docker"]},"Docker is required but not installed":{"*":["Docker je potreban, ali nije instaliran"]},"Docker Group":{"*":["Docker Grupa"]},"User not in docker group":{"*":["Korisnik nije u docker grupi"]},"Add to group":{"*":["Dodaj u grupu"]},"Configure your Samsung TV":{"*":["Konfigurirajte svoj Samsung TV"]},"Continue to Device Setup":{"*":["Nastavi na Postavljanje Uređaja"]},"Ready":{"*":["Spreman"]},"Permission required":{"*":["Potrebna dozvola"]},"Not running":{"*":["Nije u radu"]},"Start":{"*":["Započni"]},"Not installed":{"*":["Nije instalirano"]},"Added to group":{"*":["Dodano u grupu"]},"Select your distribution:\n\nThis will require elevated privileges (sudo). You may be prompted for your password.":{"*":["Odaberite svoju distribuciju:\n\nOvo će zahtijevati povišene privilegije (sudo). Možda ćete biti zatraženi da unesete svoju lozinku."]},"Arch/Manjaro":{"*":["Arch/Manjaro"]},"Debian/Ubuntu":{"*":["Debian/Ubuntu"]},"Fedora/RHEL":{"*":["Fedora/RHEL"]},"Installing Docker...":{"*":["Instaliranje Dockera..."]},"Docker installed! Checking status...":{"*":["Docker je instaliran! Provjeravam status..."]},"Installation failed: {msg}":{"*":["Instalacija nije uspjela: {msg}"]},"General":{"*":["Općenito"]},"Docker Settings":{"*":["Postavke Dockera"]},"Configure Docker behavior and settings":{"*":["Konfigurirajte ponašanje i postavke Dockera"]},"Docker Image":{"*":["Docker slika"]},"Auto-pull Updates":{"*