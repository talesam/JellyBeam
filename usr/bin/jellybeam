#!/bin/sh
# Wrapper to execute jellybeam
# Detects the installation directory
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
JELLYBEAM_DIR="$SCRIPT_DIR/../share/jellybeam"
# If installed on the system
if [ ! -d "$JELLYBEAM_DIR" ]; then
    JELLYBEAM_DIR="/usr/share/jellybeam"
fi
# Execute main.py using system Python (not pyenv)
exec /usr/bin/python3 "$JELLYBEAM_DIR/main.py" "$@"
